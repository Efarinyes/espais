# Còpia aquest fitxer a .env. No versionis .env.
# Docker local: ESPAIS_DOMAIN=http://localhost (HTTP al port 80).
# VPS: el domini real, sense esquema. Caddy demana el certificat tot sol.
ESPAIS_DOMAIN=example.com
ESPAIS_SECRET=CHANGE_ME
DATABASE_URL=sqlite:////data/espais.sqlite3
# Alpha amb Mailpit: host mailpit, port 1025, sense STARTTLS ni usuari.
# Un relay futur (per exemple Brevo): host i port del proveïdor, STARTTLS=1, usuari i contrasenya.
# El domini de l’app i el domini que signi el correu poden ser diferents.
ESPAIS_SMTP_HOST=mailpit
ESPAIS_SMTP_PORT=1025
ESPAIS_SMTP_FROM=espais@example.com
ESPAIS_SMTP_STARTTLS=
ESPAIS_SMTP_USER=
ESPAIS_SMTP_PASSWORD=
