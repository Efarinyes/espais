# Còpia aquest fitxer a .env. No versionis .env.
# Docker local: ESPAIS_DOMAIN=http://localhost (HTTP al port 80).
# VPS: el domini real, sense esquema. Caddy demana el certificat tot sol.
ESPAIS_DOMAIN=example.com
ESPAIS_SECRET=CHANGE_ME
DATABASE_URL=sqlite:////data/espais.sqlite3
# Alpha amb Mailpit: host mailpit, port 1025, sense STARTTLS ni usuari.
# Un relay futur (per exemple Brevo): host i port del proveïdor, STARTTLS=1, usuari i contrasenya.
# El domini de l’app i el domini que signi el correu poden ser diferents.
ESPAIS_SMTP_HOST=mailpit
ESPAIS_SMTP_PORT=1025
ESPAIS_SMTP_FROM=espais@example.com
ESPAIS_SMTP_STARTTLS=
ESPAIS_SMTP_USER=
ESPAIS_SMTP_PASSWORD=

# Web Push (notificacions al dispositiu del coordinador). Opcional: sense aquestes
# variables l’app funciona igual i l’avís queda només dins d’Espais.
# Cada servidor (i el teu .env local) té les seves claus. Genera-les una sola vegada:
#   micromamba run -n espais python tools/generar-claus-vapid.py
# Copia al .env les línies ESPAIS_VAPID_PRIVATE_KEY i ESPAIS_VAPID_SUBJECT que imprimeix.
# La línia «# Clau pública» és només informativa: el backend la calcula sol.
# ESPAIS_VAPID_PRIVATE_KEY és un secret: no el versionis ni el posis als logs.
# Si la canvies, cada coordinador ha de tornar a activar les notificacions.
ESPAIS_VAPID_PRIVATE_KEY=
# Contacte per als serveis de push: mailto:<correu real> o https://<domini>.
# No hi posis example.com al servidor (Apple pot rebutjar-lo).
ESPAIS_VAPID_SUBJECT=
# Sufixos de host de push admesos a més dels per defecte (separats per comes). Normalment buit.
ESPAIS_PUSH_EXTRA_HOSTS=
